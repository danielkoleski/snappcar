SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI — SERVER SIDE ONLY (Edge Functions)
OPENAI_API_KEY=sk-...

# Firebase
FIREBASE_PROJECT_ID=snappcar-xxxxx
